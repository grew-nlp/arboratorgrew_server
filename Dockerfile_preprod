FROM ubuntu:24.04

# Install system dependencies
RUN apt-get update && apt-get install -y \
	wget \
	m4 \
	unzip \
	librsvg2-bin \
	curl \
	bubblewrap \
	opam \
	libev-dev \
	libgmp-dev \
	libssl-dev \
	pkg-config


RUN opam init -y
RUN opam switch create 5.5.2

RUN git clone https://github.com/grew-nlp/arboratorgrew_server.git
RUN cd arboratorgrew_server

RUN <<EOF
eval $(opam env --switch=5.5.2)
opam remote add grew "https://opam.grew.fr"
opam install dune dream grewlib -y
cd arboratorgrew_server
dune build 
dune install
EOF

RUN opam env >> /root/.bashrc

RUN mkdir -p /var/log/grew-server && \
    mkdir -p /var/storage/grew-server

COPY config_*.json /arboratorgrew_server/

